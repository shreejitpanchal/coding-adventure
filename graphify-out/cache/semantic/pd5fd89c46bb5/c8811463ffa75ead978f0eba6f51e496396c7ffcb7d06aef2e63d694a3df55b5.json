{"nodes": [{"id": "content_spring_lessons_configuration_profiles_05_required_property_no_default_exercise", "label": "The Config Value That Must Not Have a Default", "file_type": "document", "source_file": "content/spring/lessons/configuration_profiles_05_required_property_no_default.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_required_property", "label": "Required property with no default", "file_type": "rationale", "source_file": "content/spring/lessons/configuration_profiles_05_required_property_no_default.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@Value(\"${key:default}\") is convenient but not always right -- for something like a production database URL, silently falling back to a placeholder value would fail in a much worse way than failing loudly. @Value(\"${key}\") with no ':default' at all makes context refresh fail immediately with a clear 'could not resolve placeholder' error instead of limping along with a wrong value."}, {"id": "concept_achievement_configuration_profiles_master", "label": "configuration_profiles_master achievement", "file_type": "concept", "source_file": "content/spring/lessons/configuration_profiles_05_required_property_no_default.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "content_spring_lessons_configuration_profiles_05_required_property_no_default_exercise", "target": "concept_configuration_profiles_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/spring/lessons/configuration_profiles_05_required_property_no_default.yaml", "source_location": null, "weight": 1.0}, {"source": "content_spring_lessons_configuration_profiles_05_required_property_no_default_exercise", "target": "concept_configuration", "relation"