{"nodes": [{"id": "content_java_lessons_packaging_03_semver_bump_lesson", "label": "Bumping a Semantic Version", "file_type": "document", "source_file": "content/java/lessons/packaging_03_semver_bump.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_java_lessons_packaging_03_semver_bump_semantic_versioning", "label": "Semantic Versioning (major.minor.patch)", "file_type": "concept", "source_file": "content/java/lessons/packaging_03_semver_bump.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "content_java_lessons_packaging_03_semver_bump_cascading_reset_rule", "label": "Cascading Reset Rule", "file_type": "concept", "source_file": "content/java/lessons/packaging_03_semver_bump.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bumping a version component resets every component strictly below it to zero (minor resets patch; major resets both minor and patch) since lower components lose meaning once a higher line starts fresh."}, {"id": "content_java_lessons_packaging_03_semver_bump_stub_passthrough_bug", "label": "Unchanged-Passthrough Stub Bug", "file_type": "concept", "source_file": "content/java/lessons/packaging_03_semver_bump.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bumpVersion returns its input completely unchanged regardless of which part was requested -- not a partial implementation of the bump rule but an absence of one."}], "edges": [{"source": "content_java_lessons_packaging_03_semver_bump_lesson", "target": "content_java_lessons_packaging_03_semver_bump_semantic_versioning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/java/lessons/packaging_03_semver_bump.yaml", "source_location": null, "w