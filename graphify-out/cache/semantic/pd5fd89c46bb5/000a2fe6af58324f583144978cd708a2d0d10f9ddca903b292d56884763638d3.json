{"nodes": [{"id": "content_spring_lessons_configuration_profiles_03_profile_negation_exercise", "label": "Active Everywhere Except Production", "file_type": "document", "source_file": "content/spring/lessons/configuration_profiles_03_profile_negation.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_profile_negation", "label": "Profile negation (!name)", "file_type": "rationale", "source_file": "content/spring/lessons/configuration_profiles_03_profile_negation.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@Profile accepts a '!' prefix meaning 'not this profile' -- @Profile(\"!prod\") registers the bean whenever \"prod\" is NOT among the active profiles, including when no profile is set at all. It's the natural way to express a dev/debug convenience that should exist by default but must never appear in production, without having to separately list every non-prod profile that exists."}], "edges": [{"source": "content_spring_lessons_configuration_profiles_03_profile_negation_exercise", "target": "concept_configuration_profiles_category", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/spring/lessons/configuration_profiles_03_profile_negation.yaml", "source_location": null, "weight": 1.0}, {"source": "content_spring_lessons_configuration_profiles_03_profile_negation_exercise", "target": "concept_configuration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "content/spring/lessons/configuration_profiles_03_profile_negation.yaml", "source_location": null, "weight": 1.0}, {"source": "content_spring_lessons_configuration_profiles_03_profile_negation_exercise", "target": "concept_profiles", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "co