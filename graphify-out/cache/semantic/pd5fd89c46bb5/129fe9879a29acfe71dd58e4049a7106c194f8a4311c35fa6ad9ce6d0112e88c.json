{"nodes": [{"id": "_claude_skills_add_language_content_skill_skill", "label": "add-language-content skill", "file_type": "document", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_executionengine_abc", "label": "ExecutionEngine ABC", "file_type": "concept", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_category_parity", "label": "Category parity across language tracks", "file_type": "rationale", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Category parity across languages is a choice, not an enforced rule. Python/Java share the same 14 category keys; C++ ships its own smaller 6-category set; Spring goes furthest with only 3 categories (dependency_injection, bean_lifecycle, configuration_profiles) with no equivalent at all in the other tracks, since categories like packaging/deployment/observability are ecosystem/tooling concepts that fit a package manager or framework better than bare language or DI-framework content. Nothing in ExerciseEngine.categories() hardcodes which categories a language 'should' have -- it's derived purely from what's present in that language's content directory, so a different-sized category set required zero app-code changes."}, {"id": "concept_real_toolchain_verification", "label": "Real-toolchain verification step", "file_type": "rationale", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most important step when adding language content, and has caught real bugs every time it's been skipped: write the fixed solution, run it through the real engine (not a guess at output), assert success/output/contains_patterns match, and separately confirm the unedited starter code does NOT silently pass validation. Toolchain crash/error messages should be verified against actual observed stderr, not assumed."}, {"id": "concept_contains_patterns", "label": "contains_patterns structural gating", "file_type": "concept", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_category_meta", "label": "CATEGORY_META display metadata", "file_type": "concept", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_toolchain_check", "label": "Toolchain detection (check_toolchain)", "file_type": "concept", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_execution_toolchain_check_check_toolchain", "label": "check_toolchain() (code)", "file_type": "code", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_engine_categories_category_meta", "label": "CATEGORY_META dict (code)", "file_type": "code", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_engine_languages_languageinfo", "label": "LanguageInfo.available flag (code)", "file_type": "code", "source_file": ".claude/skills/add-language-content/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "concept_required_property", "ta