tput."}, {"id": "docs_architecture_derived_state_over_stored_state", "label": "Derived State Over Stored State", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_per_language_progress_isolation", "label": "Per-Language Progress Isolation via a Column", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_android_python_only_rationale", "label": "Android Support Is Python-Only By Necessity", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java/C++/Spring/Node all fundamentally depend on spawning a real subprocess toolchain that can't exist inside a non-rooted Android app sandbox, and none have an in-process fallback the way Python's PythonInProcessEngine does."}], "edges": [{"source": "docs_architecture_execution_engine_architecture", "target": "docs_development_execution_engines_overview", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_category_key_sharing", "target": "docs_development_category_parity_rationale", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_category_key_sharing", "target": "docs_development_node_category_growth", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_category_key_sharing", "target": "docs_develo